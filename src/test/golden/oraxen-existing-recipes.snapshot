===== recipes/shaped.yml =====
user_shaped:
  shape:
    - AAA
  result:
    minecraft_type: STONE

# CharmedChars - Pyrite Tool Recipes
charmedchars_pyrite_pickaxe:
  shape:
    - PPP
    - _S_
    - _S_
  result:
    oraxen_item: pyrite_pickaxe
  ingredients:
    P:
      oraxen_item: pyrite_ingot
    S:
      minecraft_type: STICK

charmedchars_pyrite_axe:
  shape:
    - PP_
    - PS_
    - _S_
  result:
    oraxen_item: pyrite_axe
  ingredients:
    P:
      oraxen_item: pyrite_ingot
    S:
      minecraft_type: STICK

charmedchars_pyrite_shovel:
  shape:
    - _P_
    - _S_
    - _S_
  result:
    oraxen_item: pyrite_shovel
  ingredients:
    P:
      oraxen_item: pyrite_ingot
    S:
      minecraft_type: STICK

charmedchars_pyrite_hoe:
  shape:
    - PP_
    - _S_
    - _S_
  result:
    oraxen_item: pyrite_hoe
  ingredients:
    P:
      oraxen_item: pyrite_ingot
    S:
      minecraft_type: STICK

===== recipes/shapeless.yml =====
user_shapeless:
  result:
    minecraft_type: STONE

# CharmedChars - Pyrite Ingot Recipe
charmedchars_pyrite_ingot:
  result:
    oraxen_item: pyrite_ingot
  ingredients:
    A:
      amount: 1
      minecraft_type: IRON_INGOT
    B:
      amount: 1
      minecraft_type: REDSTONE

# CharmedChars - Pyrite Ingot (Potent Sulfur alt)
charmedchars_pyrite_ingot_sulfur:
  result:
    oraxen_item: pyrite_ingot
  ingredients:
    A:
      amount: 1
      minecraft_type: IRON_INGOT
    B:
      amount: 1
      minecraft_type: POTENT_SULFUR
